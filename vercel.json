{
  "functions": {
    "app/api/twilio/voice/route.ts": {
      "maxDuration": 30
    },
    "app/api/twilio/recording/route.ts": {
      "maxDuration": 60
    }
  },
  "env": {
    "TWILIO_ACCOUNT_SID": "@twilio-account-sid",
